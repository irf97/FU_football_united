# Supply these through the chosen host's secret manager. Never commit real values.
FU_MODE=production
DATABASE_URL=
SECRET_KEY_BASE=
PHX_HOST=
PORT=8080
POOL_SIZE=10
# Optional concrete provider. Use disabled to keep login closed until configured.
FU_SMS_PROVIDER=messagebird
FU_SMS_API_KEY=
FU_SMS_ORIGINATOR=FU
# Do not define FU_SMS_ENDPOINT in production: its HTTPS endpoint is fixed.
# FU_ADMIN_PASSWORD is optional; absence disables admin login.
