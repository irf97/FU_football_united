# Dedicated local build: normal Phoenix/PostgreSQL features, visible local OTPs.
FROM hexpm/elixir:1.19.6-erlang-28.5.0.8-debian-bookworm-20261020-slim@sha256:112e516e642218af182ee3d2e84ba6a02d92056fa8e6f0772ab6013d9e5a6cf4
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git ca-certificates curl inotify-tools && rm -rf /var/lib/apt/lists/*
ENV MIX_ENV=dev FU_LOCAL_MOBILE_BUILD=1 MIX_HOME=/opt/mix HEX_HOME=/opt/hex ERL_FLAGS="+S 2:2"
WORKDIR /app
RUN mix local.hex --force && mix local.rebar --force
COPY mix.exs mix.lock ./
RUN mix deps.get --only dev --check-locked
COPY config/config.exs config/dev.exs config/
COPY scripts/fetch-tailwind.sh scripts/
RUN mix deps.compile && sh scripts/fetch-tailwind.sh && mix assets.setup
COPY lib lib
COPY priv priv
COPY assets assets
COPY config/runtime.exs config/
RUN mix compile --warnings-as-errors && mix assets.build
COPY local-mobile-entrypoint.sh ./
RUN chmod 755 local-mobile-entrypoint.sh && chown -R nobody:nogroup /app
ENV HEX_OFFLINE=1
USER nobody
EXPOSE 4000
ENTRYPOINT ["/app/local-mobile-entrypoint.sh"]
CMD ["serve"]
